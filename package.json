{
  "name": "rack-riot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke:dev": "npm run db:test:waitlist:dev && npm run db:test:stylist-applications:dev",
    "db:reset:dev:intake": "node ./scripts/reset-dev-intake.mjs",
    "db:test:waitlist:dev": "node ./scripts/test-waitlist-flow.mjs",
    "db:test:stylist-applications:dev": "node ./scripts/test-stylist-applications-flow.mjs",
    "db:reset:all:dev": "zsh ./scripts/apply-supabase-migration.sh dev supabase/migrations/20260416_reset_all.sql",
    "db:reset:all:prod": "zsh ./scripts/apply-supabase-migration.sh prod supabase/migrations/20260416_reset_all.sql",
    "db:migrate:waitlist:dev": "zsh ./scripts/apply-supabase-migration.sh dev supabase/migrations/20260416_unify_waitlist.sql",
    "db:migrate:waitlist:prod": "zsh ./scripts/apply-supabase-migration.sh prod supabase/migrations/20260416_unify_waitlist.sql",
    "db:rebuild:dev": "zsh ./scripts/apply-supabase-migration.sh dev supabase/migrations/20260416_reset_all.sql && zsh ./scripts/apply-supabase-migration.sh dev supabase/schema.sql",
    "db:rebuild:prod": "zsh ./scripts/apply-supabase-migration.sh prod supabase/migrations/20260416_reset_all.sql && zsh ./scripts/apply-supabase-migration.sh prod supabase/schema.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^10.0.6",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.14"
  }
}
